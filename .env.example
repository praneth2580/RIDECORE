# Copy to .env.local (git-ignored) and uncomment what you need.
# Vite reads these when it starts or builds; the dev server restarts by
# itself when a .env file changes. Shell variables win over .env files.
#
# Quote every colour: in a .env file an unquoted # starts a comment, so an
# unquoted #e63946 would be read as empty.

# ── Map theme ─────────────────────────────────────────────────
# See DEVELOPMENT.md → "Theming the map" for every colour.

# 1. A preset: default | dark
# VITE_MAP_THEME=dark

# 2. Any part of a theme as JSON, in single quotes, on one line:
# VITE_MAP_THEME_JSON='{"route":{"active":"#e63946"},"basemap":{"water":"#9ec5e8"}}'

# 3. One colour at a time (wins over 1 and 2):
# VITE_MAP_COLOR_ROUTE_ACTIVE="#e63946"
# VITE_MAP_COLOR_ROUTE_ALTERNATIVES="#5b8def, #9b7bff, #3dbea5"
# VITE_MAP_COLOR_MARKERS_RIDER="#3b8ef0"
# VITE_MAP_COLOR_BASEMAP_WATER="#9ec5e8"
